<Page
    x:Class="PhotosManager.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotosManager.Views.Controls"
    xmlns:conv="using:PhotosManager.Converters"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:PhotosManager.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mux="using:Microsoft.UI.Xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:shared="using:Photos.Models"
    xmlns:vm="using:PhotosManager.ViewModels"
    Background="Transparent"
    Loaded="SettingsPage_Loaded"
    Style="{StaticResource ScrollingPageStyle}"
    Unloaded="SettingsPage_Unloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///PhotosManager/Styles/SettingsStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--
                If a SettingsCard's Content's AutomationProperties.Name matches its header,
                it does not announce the card header and control type, only the Content, with the card's header as AutomationProperties.Name.
                ToggleSwitch get this empty AutomationProperties.Name which is not read by the screen reader
                but forces the card's header and control type to be announced.
                This keeps the screen reader behavior consistent with other SettingsCards with different types of Content.
            -->
            <x:String x:Key="EmptyAutomationPropertiesName">&#x200B;</x:String>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SimplePageHeader
            x:Name="SettingsHeader"
            Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
            Grid.Row="0"
            Margin="{StaticResource PageHeaderMargin}"
            VerticalAlignment="Stretch"
            DataContext="{x:Bind Mode=OneTime}"
            Icon="{x:Bind ViewModel.TitleIcon, Mode=OneWay}" />

        <ScrollViewer
            Grid.Row="1"
            Padding="{StaticResource PageContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsHorizontalRailEnabled="False"
            IsVerticalRailEnabled="True"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">

            <!--
                Wrapping StackPanel in Grid to fix bug
                https://microsoft.visualstudio.com/OS/_workitems/edit/43369348/
            -->
            <Grid>
                <StackPanel
                    MaxWidth="{StaticResource SettingsItemMaxWidth}"
                    Margin="0,0,0,64"
                    Orientation="Vertical"
                    Spacing="3">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <StackPanel GettingFocus="SettingsGroup_GettingFocus">
                        <TextBlock
                            x:Name="SettingsPersonalization"
                            x:Uid="Settings_Personalization"
                            Margin="{StaticResource SubTitleTextMargin}"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <!--#region SettingsPersonalization-->
                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_AppTheme/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_AppTheme/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{StaticResource SettingsAppearanceGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <muxc:DropDownButton
                                x:Name="ThemeDropdownButtons"
                                AutomationProperties.HelpText="{Binding Content, RelativeSource={RelativeSource Self}}"
                                AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType_ComboBox'), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_AppTheme/Header'), Mode=OneTime}"
                                Content="{x:Bind ViewModel.SharedStringService.GetThemeName(ViewModel.ApplicationSettings.Theme), Mode=OneWay}">
                                <muxc:DropDownButton.Flyout>
                                    <MenuFlyout x:Name="ThemeMenuFlyout" Placement="Bottom">
                                        <muxc:RadioMenuFlyoutItem
                                            x:Name="ThemeLightItem"
                                            Command="{x:Bind ViewModel.SwitchThemeCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind mux:ElementTheme.Light, Mode=OneTime}"
                                            GroupName="AppTheme"
                                            IsChecked="{x:Bind conv:BoolConverter.Match(ViewModel.ApplicationSettings.Theme, mux:ElementTheme.Light), Mode=OneWay}"
                                            KeyDown="SettingsButton_KeyDown"
                                            Tapped="SettingsButton_Tapped"
                                            Text="{x:Bind ViewModel.GetThemeName(mux:ElementTheme.Light), Mode=OneTime}" />

                                        <muxc:RadioMenuFlyoutItem
                                            x:Name="ThemeDarkItem"
                                            Command="{x:Bind ViewModel.SwitchThemeCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind mux:ElementTheme.Dark, Mode=OneTime}"
                                            GroupName="AppTheme"
                                            IsChecked="{x:Bind conv:BoolConverter.Match(ViewModel.ApplicationSettings.Theme, mux:ElementTheme.Dark), Mode=OneWay}"
                                            KeyDown="SettingsButton_KeyDown"
                                            Tapped="SettingsButton_Tapped"
                                            Text="{x:Bind ViewModel.GetThemeName(mux:ElementTheme.Dark), Mode=OneTime}" />

                                        <muxc:RadioMenuFlyoutItem
                                            x:Name="ThemeDefaultItem"
                                            Command="{x:Bind ViewModel.SwitchThemeCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind mux:ElementTheme.Default, Mode=OneTime}"
                                            GroupName="AppTheme"
                                            IsChecked="{x:Bind conv:BoolConverter.Match(ViewModel.ApplicationSettings.Theme, mux:ElementTheme.Default), Mode=OneWay}"
                                            KeyDown="SettingsButton_KeyDown"
                                            Tapped="SettingsButton_Tapped"
                                            Text="{x:Bind ViewModel.GetThemeName(mux:ElementTheme.Default), Mode=OneTime}" />
                                    </MenuFlyout>
                                </muxc:DropDownButton.Flyout>
                            </muxc:DropDownButton>
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.Localized('Settings_GalleryAttribution/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.Localized('Settings_GalleryAttribution/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{StaticResource SettingsAttributesSwitchGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.Name="{StaticResource EmptyAutomationPropertiesName}"
                                IsOn="{x:Bind ViewModel.ShowGalleryTileAttributesSetting, Mode=TwoWay}"
                                KeyDown="SettingsButton_KeyDown"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.Localized('Settings_Geolocation_Consent/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.Localized('Settings_Geolocation_Consent/Header'), Mode=OneTime}"
                            Visibility="{x:Bind ViewModel.LocationSearchSettingsVisibility, Mode=OneWay}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon
                                    FontFamily="{ThemeResource PhotosUWPFontFamily}"
                                    FontSize="{StaticResource IconFontSize}"
                                    Glyph="{StaticResource SettingsLocationGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.Name="{StaticResource EmptyAutomationPropertiesName}"
                                IsOn="{x:Bind ViewModel.EnableLocationBasedFeaturesSetting, Mode=TwoWay}"
                                KeyDown="SettingsButton_KeyDown"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.Localized('Settings_ICloudPhotos/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.Localized('Settings_ICloudPhotos/Header'), Mode=OneTime}"
                            Visibility="{x:Bind ViewModel.ICloudPhotosSettingsVisibility, Mode=OneWay}">
                            <ctc:SettingsCard.HeaderIcon>
                                <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Common/ICloudPhotosIcon-28.png" />
                            </ctc:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="CloudPhotosSwitch"
                                AutomationProperties.Name="{StaticResource EmptyAutomationPropertiesName}"
                                IsOn="{x:Bind ViewModel.ShowICloudPhotosSetting, Mode=TwoWay}"
                                KeyDown="SettingsButton_KeyDown"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_DeleteDialog/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_DeleteDialog/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{StaticResource SettingsDeleteConfirmationGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="DeleteDialogToggleSwitch"
                                AutomationProperties.Name="{StaticResource EmptyAutomationPropertiesName}"
                                IsOn="{x:Bind ViewModel.ShowDeleteConfirmationDialogSetting, Mode=TwoWay}"
                                KeyDown="SettingsButton_KeyDown"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            x:Name="Settings_ExitMoodboardDialog"
                            x:Load="{x:Bind ShowImageCreatorSuppressDialogSetting, Mode=OneTime}"
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_ExitMoodboardDialog/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_ExitMoodboardDialog/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <IconSourceElement IconSource="{x:Bind ViewModel.ImageCreatorIcon, Mode=OneWay}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                x:Name="ExitMoodboardDialogToggleSwitch"
                                AutomationProperties.Name="{StaticResource EmptyAutomationPropertiesName}"
                                IsOn="{x:Bind ViewModel.ShowMoodboardExitConfirmationDialogSetting, Mode=TwoWay}"
                                KeyDown="SettingsButton_KeyDown"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_AccessibilityMouseWheel/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_AccessibilityMouseWheel/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{StaticResource SettingsMouseWheelGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <muxc:DropDownButton
                                x:Name="MouseWheelDropdownButtons"
                                AutomationProperties.HelpText="{Binding Content, RelativeSource={RelativeSource Self}}"
                                AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType_ComboBox'), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_AccessibilityMouseWheel/Header'), Mode=OneTime}"
                                Content="{x:Bind ViewModel.SharedStringService.GetMouseWheelText(ViewModel.ApplicationSettings.MouseWheelControl), Mode=OneWay}">
                                <muxc:DropDownButton.Flyout>
                                    <MenuFlyout x:Name="MouseWheelMenuFlyout" Placement="Bottom">
                                        <muxc:RadioMenuFlyoutItem
                                            x:Name="MouseWheelZoomItem"
                                            Command="{x:Bind ViewModel.SwitchMouseWheelControlCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind shared:MouseWheelControlEnum.Zoom, Mode=OneTime}"
                                            GroupName="MouseWheelSetting"
                                            IsChecked="{x:Bind conv:BoolConverter.Match(ViewModel.ApplicationSettings.MouseWheelControl, shared:MouseWheelControlEnum.Zoom), Mode=OneWay}"
                                            KeyDown="SettingsButton_KeyDown"
                                            Tapped="SettingsButton_Tapped"
                                            Text="{x:Bind ViewModel.SharedStringService.GetMouseWheelText(shared:MouseWheelControlEnum.Zoom), Mode=OneTime}" />

                                        <muxc:RadioMenuFlyoutItem
                                            x:Name="MouseWheelNavigateItem"
                                            Command="{x:Bind ViewModel.SwitchMouseWheelControlCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind shared:MouseWheelControlEnum.Navigate, Mode=OneTime}"
                                            GroupName="MouseWheelSetting"
                                            IsChecked="{x:Bind conv:BoolConverter.Match(ViewModel.ApplicationSettings.MouseWheelControl, shared:MouseWheelControlEnum.Navigate), Mode=OneWay}"
                                            KeyDown="SettingsButton_KeyDown"
                                            Tapped="SettingsButton_Tapped"
                                            Text="{x:Bind ViewModel.SharedStringService.GetMouseWheelText(shared:MouseWheelControlEnum.Navigate), Mode=OneTime}" />
                                    </MenuFlyout>
                                </muxc:DropDownButton.Flyout>
                            </muxc:DropDownButton>
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            x:Name="Settings_HeicCodecMissing"
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ViewModel.HeicCodecMissingDescription, Mode=OneWay}"
                            Header="{x:Bind ViewModel.HeicCodecMissingTitle, Mode=OneWay}"
                            Visibility="{x:Bind conv:VisibilityConverter.Convert(ViewModel.IsHeicCodecMissing), Mode=OneWay}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon
                                    FontFamily="{ThemeResource PhotosUWPFontFamily}"
                                    FontSize="{StaticResource IconFontSize}"
                                    Glyph="{x:Bind ViewModel.HeicCodecMissingGlyph, Mode=OneWay}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <Button
                                x:Name="Settings_HeicButton"
                                Command="{x:Bind ViewModel.LaunchHeicButtonCommand}"
                                Content="{x:Bind ViewModel.HeicCodecMissingButtonText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_SmallMediaDefaultView/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_SmallMediaDefaultView/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon
                                    FontFamily="{StaticResource PhotosUWPFontFamily}"
                                    FontSize="{StaticResource IconFontSize}"
                                    Glyph="{StaticResource SettingsSmallMediaDefaultViewGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <muxc:DropDownButton
                                x:Name="SmallMediaDefaultViewDropDown"
                                AutomationProperties.HelpText="{Binding Content, RelativeSource={RelativeSource Self}}"
                                AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType_ComboBox'), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind ex:StringExtensions.SharedResourceLocalized('Settings_SmallMediaDefaultView/Header'), Mode=OneTime}"
                                Content="{x:Bind ViewModel.SharedStringService.GetSmallMediaDefaultZoomText(ViewModel.SmallMediaDefaultZoom), Mode=OneWay}">
                                <muxc:DropDownButton.Flyout>
                                    <MenuFlyout x:Name="SmallMediaDefaultViewMenuFlyout" Placement="Bottom">
                                        <muxc:RadioMenuFlyoutItem
                                            x:Name="SmallMediaFitViewItem"
                                            Command="{x:Bind ViewModel.SwitchSmallMediaDefaultZoomCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind shared:SmallMediaDefaultZoom.AlwaysFitView, Mode=OneTime}"
                                            IsChecked="{x:Bind conv:BoolConverter.Match(ViewModel.ApplicationSettings.SmallMediaDefaultZoom, shared:SmallMediaDefaultZoom.AlwaysFitView), Mode=OneWay}"
                                            KeyDown="SettingsButton_KeyDown"
                                            Tapped="SettingsButton_Tapped"
                                            Text="{x:Bind ViewModel.SharedStringService.GetSmallMediaDefaultZoomText(shared:SmallMediaDefaultZoom.AlwaysFitView), Mode=OneTime}" />

                                        <muxc:RadioMenuFlyoutItem
                                            x:Name="SmallMediaViewActualSizeItem"
                                            Command="{x:Bind ViewModel.SwitchSmallMediaDefaultZoomCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind shared:SmallMediaDefaultZoom.AlwaysViewActualSize, Mode=OneTime}"
                                            IsChecked="{x:Bind conv:BoolConverter.Match(ViewModel.ApplicationSettings.SmallMediaDefaultZoom, shared:SmallMediaDefaultZoom.AlwaysViewActualSize), Mode=OneWay}"
                                            KeyDown="SettingsButton_KeyDown"
                                            Tapped="SettingsButton_Tapped"
                                            Text="{x:Bind ViewModel.SharedStringService.GetSmallMediaDefaultZoomText(shared:SmallMediaDefaultZoom.AlwaysViewActualSize), Mode=OneTime}" />
                                    </MenuFlyout>
                                </muxc:DropDownButton.Flyout>
                            </muxc:DropDownButton>
                        </ctc:SettingsCard>

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Header="{x:Bind ex:StringExtensions.Localized('Settings_ImageCategorization_Consent/Header'), Mode=OneTime}"
                            Visibility="{x:Bind ViewModel.IsImageCategorizationUIEnabled}">
                            <ctc:SettingsCard.Description>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{x:Bind ViewModel.ImageAutocategorizationConsentContent, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    <HyperlinkButton
                                        AutomationProperties.Name="{x:Bind ex:StringExtensions.Localized('LearnMore_ImageCategorization/AutomationProperties/Name'), Mode=OneTime}"
                                        Content="{x:Bind ex:StringExtensions.Localized('LearnMore_Generic'), Mode=OneTime}"
                                        NavigateUri="{x:Bind ImageCategorizationConsentViewModel.LearnMoreUri, Mode=OneWay}" />
                                </StackPanel>

                            </ctc:SettingsCard.Description>
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{StaticResource SettingsImageCategorizationGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <ToggleSwitch
                                AutomationProperties.Name="{StaticResource EmptyAutomationPropertiesName}"
                                IsOn="{x:Bind ViewModel.AllowImageCategorizationSetting, Mode=TwoWay}"
                                KeyDown="SettingsButton_KeyDown"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>

                        <!--#endregion-->
                    </StackPanel>

                    <StackPanel
                        x:Name="AccountStackPanel"
                        GettingFocus="SettingsGroup_GettingFocus"
                        Visibility="{x:Bind ViewModel.IsAccountSectionVisible, Mode=OneWay}">
                        <TextBlock
                            x:Name="SettingsAccount"
                            x:Uid="Settings_Account"
                            Margin="{StaticResource SubTitleTextMargin}"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!--#region SettingsAccount-->
                        <ctc:SettingsCard
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ViewModel.AccountSettingsCardDescription, Mode=OneWay}"
                            Header="{x:Bind ViewModel.AccountSettingsCardHeader, Mode=OneWay}">
                            <ctc:SettingsCard.HeaderIcon>
                                <IconSourceElement IconSource="{x:Bind ViewModel.AccountSettingsCardHeaderIcon, Mode=OneWay}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <Button Command="{x:Bind ViewModel.AccountSettingsCardButtonCommand}" Content="{x:Bind ViewModel.AccountSettingsCardButtonContent, Mode=OneWay}" />
                        </ctc:SettingsCard>
                        <!--#endregion-->
                    </StackPanel>

                    <StackPanel GettingFocus="SettingsGroup_GettingFocus">
                        <TextBlock
                            x:Name="SettingsOneDrive"
                            x:Uid="Settings_OneDrive"
                            Margin="{StaticResource SubTitleTextMargin}"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!--#region SettingsOneDrive-->
                        <StackPanel
                            x:Name="OneDriveAccountsPanel"
                            HorizontalAlignment="Stretch"
                            Loaded="OneDriveAccountsPanel_Loaded" />

                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Header="{x:Bind ex:StringExtensions.Localized('Settings_OneDriveDataCollectionPolicy/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.Description>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{x:Bind ViewModel.OneDriveDataCollectionPolicyContent, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    <HyperlinkButton
                                        AutomationProperties.Name="{x:Bind ex:StringExtensions.Localized('LearnMore_OneDriveDataCollectionPolicy/AutomationProperties/Name'), Mode=OneTime}"
                                        Content="{x:Bind ex:StringExtensions.Localized('LearnMore_Generic'), Mode=OneTime}"
                                        NavigateUri="{x:Bind ViewModel.OneDriveLearnMoreUri, Mode=OneWay}" />
                                </StackPanel>

                            </ctc:SettingsCard.Description>
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon
                                    FontFamily="{StaticResource PhotosUWPFontFamily}"
                                    FontSize="{StaticResource IconFontSize}"
                                    Glyph="{StaticResource SettingsOneDriveLearnMoreGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <HyperlinkButton
                                Click="OneDriveManageDataSettingsLink_Click"
                                KeyDown="SettingsButton_KeyDown"
                                NavigateUri="{x:Bind vm:SettingsViewModel.OneDriveManageDataSettingsUri, Mode=OneTime}"
                                Tapped="SettingsButton_Tapped">
                                <HyperlinkButton.Resources>
                                    <ResourceDictionary>
                                        <StaticResource x:Key="ButtonPadding" ResourceKey="SettingsHyperlinkButtonPadding" />
                                    </ResourceDictionary>
                                </HyperlinkButton.Resources>
                                <TextBlock x:Uid="Settings_OneDriveManagerDataSettings" TextWrapping="WrapWholeWords" />
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{x:Bind vm:SettingsViewModel.OneDriveManageDataSettingsUri, Mode=OneTime}" Placement="Top" />
                                </ToolTipService.ToolTip>
                            </HyperlinkButton>
                        </ctc:SettingsCard>
                        <!--#endregion-->
                    </StackPanel>

                    <StackPanel GettingFocus="SettingsGroup_GettingFocus">
                        <TextBlock
                            x:Name="SettingsClipChamp"
                            x:Uid="Settings_ClipChamp"
                            Margin="{StaticResource SubTitleTextMargin}"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!--#region SettingsClipchamp-->
                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Header="{x:Bind ViewModel.ClipchampTitle, Mode=OneWay}">
                            <ctc:SettingsCard.Description>
                                <controls:TextBlockWithHyperlink
                                    x:Name="ClipchampLearnMoreHyperlink"
                                    HyperlinkUri="{x:Bind ViewModel.ClipchampLearnMoreUri, Mode=OneWay}"
                                    Source="Clipchamp"
                                    Text="{x:Bind ViewModel.ClipchampLearnMoreContent, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </ctc:SettingsCard.Description>
                            <ctc:SettingsCard.HeaderIcon>

                                <IconSourceElement IconSource="{x:Bind ViewModel.ClipchampIcon, Mode=OneTime}" />
                                <!-- <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Common/ClipchampIcon-28.png" /> -->
                            </ctc:SettingsCard.HeaderIcon>
                            <Button
                                x:Name="ClipchampButton"
                                x:Uid="Settings_ClipchampButton"
                                Command="{x:Bind ViewModel.LaunchClipchampCommand}"
                                Content="{x:Bind ViewModel.ClipchampButtonContent, Mode=OneWay}"
                                KeyDown="SettingsButton_KeyDown"
                                Style="{StaticResource AccentButtonStyle}"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>
                        <!--#endregion-->
                    </StackPanel>

                    <StackPanel GettingFocus="SettingsGroup_GettingFocus" Visibility="{x:Bind ViewModel.PerceptibleWatermarkSectionVisible(), Mode=OneWay}">
                        <TextBlock
                            x:Name="SettingsAIWatermark"
                            Margin="{StaticResource SubTitleTextMargin}"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.SharedStringService.GetResourceString('Settings_PerceptibleWatermark/Text'), Mode=OneTime}" />
                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ViewModel.SharedStringService.GetResourceString('Settings_PerceptibleWatermark/Description'), Mode=OneTime}"
                            Header="{x:Bind ViewModel.SharedStringService.GetResourceString('Settings_PerceptibleWatermark/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xF4A5;" />
                            </ctc:SettingsCard.HeaderIcon>
                            <muxc:DropDownButton
                                x:Name="PerceptibleWatermarkDropdown"
                                AutomationProperties.HelpText="{x:Bind ViewModel.SharedStringService.GetResourceString('Settings_PerceptibleWatermark/Description'), Mode=OneTime}"
                                Content="{x:Bind ViewModel.SharedStringService.GetPerceptibleWatermarkSettingText(ViewModel.PerceptibleWatermarkSetting), Mode=OneWay}">
                                <muxc:DropDownButton.Flyout>
                                    <MenuFlyout x:Name="PerceptibleWatermarkMenuFlyout" Placement="Bottom">
                                        <muxc:RadioMenuFlyoutItem
                                            Command="{x:Bind ViewModel.SwitchPerceptibleWatermarkSettingCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind shared:PerceptibleWatermarkSetting.Never, Mode=OneTime}"
                                            GroupName="WatermarkSetting"
                                            IsChecked="{x:Bind ViewModel.IsPerceptibleWatermarkSetting(shared:PerceptibleWatermarkSetting.Never), Mode=OneWay}"
                                            Text="{x:Bind ViewModel.SharedStringService.GetPerceptibleWatermarkSettingText(shared:PerceptibleWatermarkSetting.Never), Mode=OneTime}" />
                                        <muxc:RadioMenuFlyoutItem
                                            Command="{x:Bind ViewModel.SwitchPerceptibleWatermarkSettingCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind shared:PerceptibleWatermarkSetting.Always, Mode=OneTime}"
                                            GroupName="WatermarkSetting"
                                            IsChecked="{x:Bind ViewModel.IsPerceptibleWatermarkSetting(shared:PerceptibleWatermarkSetting.Always), Mode=OneWay}"
                                            Text="{x:Bind ViewModel.SharedStringService.GetPerceptibleWatermarkSettingText(shared:PerceptibleWatermarkSetting.Always), Mode=OneTime}" />
                                        <muxc:RadioMenuFlyoutItem
                                            Command="{x:Bind ViewModel.SwitchPerceptibleWatermarkSettingCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind shared:PerceptibleWatermarkSetting.AskEveryTime, Mode=OneTime}"
                                            GroupName="WatermarkSetting"
                                            IsChecked="{x:Bind ViewModel.IsPerceptibleWatermarkSetting(shared:PerceptibleWatermarkSetting.AskEveryTime), Mode=OneWay}"
                                            Text="{x:Bind ViewModel.SharedStringService.GetPerceptibleWatermarkSettingText(shared:PerceptibleWatermarkSetting.AskEveryTime), Mode=OneTime}" />
                                    </MenuFlyout>
                                </muxc:DropDownButton.Flyout>
                            </muxc:DropDownButton>
                        </ctc:SettingsCard>
                    </StackPanel>

                    <StackPanel GettingFocus="SettingsGroup_GettingFocus">
                        <TextBlock
                            x:Name="SettingsPrivacyAndSecurity"
                            x:Uid="Settings_PrivacyAndSecurity"
                            Margin="{StaticResource SubTitleTextMargin}"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!--#region SettingsPrivacy-->
                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Description="{x:Bind ex:StringExtensions.Localized('Settings_Privacy/Description'), Mode=OneTime}"
                            Header="{x:Bind ex:StringExtensions.Localized('Settings_Privacy/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{StaticResource PrivacyGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <HyperlinkButton
                                Click="ManagePrivacyLink_Click"
                                KeyDown="SettingsButton_KeyDown"
                                NavigateUri="{x:Bind vm:SettingsViewModel.PrivacyDashboardUri, Mode=OneTime}"
                                Tapped="SettingsButton_Tapped">
                                <HyperlinkButton.Resources>
                                    <ResourceDictionary>
                                        <StaticResource x:Key="ButtonPadding" ResourceKey="SettingsHyperlinkButtonPadding" />
                                    </ResourceDictionary>
                                </HyperlinkButton.Resources>
                                <TextBlock Text="{x:Bind ex:StringExtensions.Localized('Settings_AboutPrivacyDashboardLink/Text'), Mode=OneTime}" TextWrapping="WrapWholeWords" />
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{x:Bind vm:SettingsViewModel.PrivacyDashboardUri, Mode=OneTime}" Placement="Top" />
                                </ToolTipService.ToolTip>
                            </HyperlinkButton>
                        </ctc:SettingsCard>
                        <ctc:SettingsCard
                            AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('SettingsCard_ControlType'), Mode=OneTime}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                            Header="{x:Bind ex:StringExtensions.Localized('Settings_WindowsDataCollectionPolicy/Header'), Mode=OneTime}">
                            <ctc:SettingsCard.Description>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{x:Bind ViewModel.WindowsDataCollectionPolicyContent, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    <HyperlinkButton
                                        AutomationProperties.Name="{x:Bind ex:StringExtensions.Localized('LearnMore_WindowsDataCollectionPolicy/AutomationProperties/Name'), Mode=OneTime}"
                                        Content="{x:Bind ex:StringExtensions.Localized('LearnMore_Generic'), Mode=OneTime}"
                                        NavigateUri="{x:Bind ViewModel.WindowsLearnMoreUri, Mode=OneWay}" />
                                </StackPanel>
                            </ctc:SettingsCard.Description>
                            <ctc:SettingsCard.HeaderIcon>
                                <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{StaticResource SettingsWindowsLearnMoreGlyph}" />
                            </ctc:SettingsCard.HeaderIcon>
                            <Button
                                x:Name="WindowsManageDataSettingsButton"
                                Command="{x:Bind ViewModel.InvokeWindowsManageDataSettingsCommand, Mode=OneWay}"
                                Content="{x:Bind ViewModel.WindowsManageDataSettingsButtonName}"
                                KeyDown="SettingsButton_KeyDown"
                                Style="{StaticResource AccentButtonStyle}"
                                Tapped="SettingsButton_Tapped" />
                        </ctc:SettingsCard>
                        <!--#endregion-->
                    </StackPanel>

                    <StackPanel GettingFocus="SettingsGroup_GettingFocus">
                        <TextBlock
                            x:Name="SettingsAbout"
                            x:Uid="Settings_About"
                            Margin="{StaticResource SubTitleTextMargin}"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!--#region SettingsAbout-->
                        <ctc:SettingsExpander
                            x:Name="AboutPhotosExpander"
                            AutomationProperties.HelpText="{x:Bind GetVersionFriendlyName(ViewModel.VersionDescription), Mode=OneWay}"
                            Header="{x:Bind ViewModel.AboutPhotosTitle, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.VersionDescription, Mode=OneTime}"
                                TextWrapping="Wrap" />
                            <ctc:SettingsExpander.Description>
                                <controls:TextBlockWithHyperlink
                                    x:Name="AboutPhotosLearnMoreHyperlink"
                                    HyperlinkUri="{x:Bind ViewModel.AboutPhotosLearnMoreUri, Mode=OneWay}"
                                    Source="PhotosHelpPage"
                                    Text="{x:Bind ViewModel.AboutPhotosLearnMoreContent, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </ctc:SettingsExpander.Description>
                            <ctc:SettingsExpander.HeaderIcon>
                                <BitmapIcon x:Name="AboutPhotosLogoIcon" ShowAsMonochrome="False" />
                            </ctc:SettingsExpander.HeaderIcon>
                            <ctc:SettingsExpander.ItemsHeader>
                                <StackPanel>
                                    <ctc:SettingsCard Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                                        <ctc:SettingsCard.Header>
                                            <ContentControl
                                                AutomationProperties.LabeledBy="{Binding ElementName=SettingsAboutSessionId}"
                                                FocusVisualMargin="-4"
                                                UseSystemFocusVisuals="True">
                                                <TextBlock
                                                    x:Name="SettingsAboutSessionId"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind ViewModel.SessionId, Mode=OneWay}" />
                                            </ContentControl>
                                        </ctc:SettingsCard.Header>
                                    </ctc:SettingsCard>
                                    <ctc:SettingsCard Style="{StaticResource DefaultSettingsExpanderItemStyle}" Visibility="{x:Bind ViewModel.PhotosPackagesListVisibility, Mode=OneWay}">
                                        <ctc:SettingsCard.Header>
                                            <ContentControl AutomationProperties.LabeledBy="{Binding ElementName=SettingsPhotosPackagesHeader}">
                                                <TextBlock x:Name="SettingsPhotosPackagesHeader" Text="Installed Packages and Extensions" />
                                            </ContentControl>
                                        </ctc:SettingsCard.Header>
                                        <ctc:SettingsCard.Description>
                                            <ContentControl AutomationProperties.LabeledBy="{Binding ElementName=SettingsPhotosPackagesList}">
                                                <TextBlock
                                                    x:Name="SettingsPhotosPackagesList"
                                                    FontSize="14"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind ViewModel.PhotosPackagesListString, Mode=OneWay}" />
                                            </ContentControl>
                                        </ctc:SettingsCard.Description>
                                    </ctc:SettingsCard>
                                    <ctc:SettingsCard
                                        HorizontalContentAlignment="Left"
                                        AutomationProperties.Name="{x:Bind ex:StringExtensions.Localized('Settings_AboutPhotos_LinksGroup/AutomationProperties/Name'), Mode=OneTime}"
                                        ContentAlignment="Vertical"
                                        Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                                        <StackPanel Margin="{StaticResource ExpanderContentHyperlinkButtonMargin}" Orientation="Vertical">
                                            <HyperlinkButton
                                                Command="{x:Bind ViewModel.LaunchPrivacyStatementUriCommand}"
                                                KeyDown="SettingsButton_KeyDown"
                                                Tapped="SettingsButton_Tapped">
                                                <TextBlock x:Uid="Settings_AboutPrivacyStatementLink" TextWrapping="WrapWholeWords" />
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind vm:SettingsViewModel.PrivacyStatementUri, Mode=OneTime}" Placement="Top" />
                                                </ToolTipService.ToolTip>
                                            </HyperlinkButton>
                                            <HyperlinkButton
                                                Click="ConsumerHealthPolicyLink_Click"
                                                KeyDown="SettingsButton_KeyDown"
                                                NavigateUri="{x:Bind vm:SettingsViewModel.ConsumerHealthPolicyUri, Mode=OneTime}"
                                                Tapped="SettingsButton_Tapped"
                                                Visibility="{x:Bind ViewModel.ConsumerHealthPolicyVisibility}">
                                                <TextBlock x:Uid="Settings_AboutConsumerHealthDataLink" TextWrapping="WrapWholeWords" />
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind vm:SettingsViewModel.ConsumerHealthPolicyUri, Mode=OneTime}" Placement="Top" />
                                                </ToolTipService.ToolTip>
                                            </HyperlinkButton>
                                            <HyperlinkButton
                                                Command="{x:Bind ViewModel.LaunchAboutEulaUriCommand}"
                                                KeyDown="SettingsButton_KeyDown"
                                                Tapped="SettingsButton_Tapped">
                                                <TextBlock x:Uid="Settings_AboutEULA" TextWrapping="WrapWholeWords" />
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind vm:SettingsViewModel.AboutEulaUri, Mode=OneTime}" Placement="Top" />
                                                </ToolTipService.ToolTip>
                                            </HyperlinkButton>
                                            <HyperlinkButton
                                                Click="ServicesAgreementLink_Click"
                                                KeyDown="SettingsButton_KeyDown"
                                                NavigateUri="{x:Bind vm:SettingsViewModel.ServicesAgreementUri, Mode=OneTime}"
                                                Tapped="SettingsButton_Tapped">
                                                <TextBlock x:Uid="Settings_AboutServicesAgreement" TextWrapping="WrapWholeWords" />
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind vm:SettingsViewModel.ServicesAgreementUri, Mode=OneTime}" Placement="Top" />
                                                </ToolTipService.ToolTip>
                                            </HyperlinkButton>
                                            <HyperlinkButton
                                                Click="ThirdPartyNotice_Click"
                                                KeyDown="SettingsButton_KeyDown"
                                                Tapped="SettingsButton_Tapped">
                                                <TextBlock
                                                    x:Name="ThirdPartyOSSTextBlock"
                                                    Text="{x:Bind ThirdPartyOSSTextBlockText, Mode=OneTime}"
                                                    TextWrapping="WrapWholeWords" />
                                            </HyperlinkButton>
                                        </StackPanel>
                                    </ctc:SettingsCard>
                                </StackPanel>
                            </ctc:SettingsExpander.ItemsHeader>
                        </ctc:SettingsExpander>
                        <HyperlinkButton
                            Margin="{StaticResource ExpanderMargin}"
                            Click="AboutHelpLink_Click"
                            KeyDown="SettingsButton_KeyDown"
                            NavigateUri="{x:Bind vm:SettingsViewModel.HelpUri, Mode=OneTime}"
                            Tapped="SettingsButton_Tapped">
                            <HyperlinkButton.Resources>
                                <ResourceDictionary>
                                    <StaticResource x:Key="ButtonPadding" ResourceKey="SettingsHyperlinkButtonPadding" />
                                </ResourceDictionary>
                            </HyperlinkButton.Resources>
                            <TextBlock x:Uid="Settings_AboutHelpLink" TextWrapping="WrapWholeWords" />
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind vm:SettingsViewModel.HelpUri, Mode=OneTime}" Placement="Top" />
                            </ToolTipService.ToolTip>
                        </HyperlinkButton>

                        <HyperlinkButton
                            Margin="{StaticResource ExpanderMargin}"
                            Command="{x:Bind ViewModel.LaunchFeedbackHubCommand}"
                            KeyDown="SettingsButton_KeyDown"
                            Tapped="SettingsButton_Tapped"
                            Visibility="{x:Bind ViewModel.FeedbackLinkVisibility}">
                            <HyperlinkButton.Resources>
                                <ResourceDictionary>
                                    <StaticResource x:Key="ButtonPadding" ResourceKey="SettingsHyperlinkButtonPadding" />
                                </ResourceDictionary>
                            </HyperlinkButton.Resources>
                            <TextBlock x:Uid="Settings_FeedbackButton" TextWrapping="WrapWholeWords" />
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="Settings_FeedbackButtonTooltip" Placement="Top" />
                            </ToolTipService.ToolTip>
                        </HyperlinkButton>
                        <!--#endregion-->
                    </StackPanel>
                </StackPanel>
            </Grid>

        </ScrollViewer>
    </Grid>
</Page>
