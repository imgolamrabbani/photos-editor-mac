<Page
    x:Class="PhotosManager.Views.Pages.OneDriveRecommendationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotosManager.Views.Controls"
    xmlns:conv="using:PhotosManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataTemplates="using:PhotosManager.DataTemplates"
    xmlns:ex="using:PhotosManager.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhotosManager.Models"
    xmlns:oneDrive="using:OneDriveUI.Models"
    xmlns:sltor="using:PhotosManager.Selectors"
    xmlns:vm="using:PhotosManager.ViewModels"
    Style="{StaticResource ScrollingPageStyle}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///PhotosManager/Styles/RecommendationPageStyles.xaml" />
                <dataTemplates:RecommendationItemTemplate />
                <ResourceDictionary>
                    <sltor:RecommendationItemTemplateSelector
                        x:Key="RecommendationItemTemplateSelector"
                        ClipchampItemTemplate="{StaticResource ClipchampTemplate}"
                        MemoriesItemTemplate="{StaticResource MemoriesTemplate}"
                        RecommendationItemTemplate="{StaticResource RecommendationTemplate}" />

                    <Thickness x:Key="EmptyStateButtonMargin">30</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid
        x:Name="ContentArea"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:SimplePageHeader
            Title="{x:Bind ex:StringExtensions.Localized('OneDriveMemoriesPageName'), Mode=OneTime}"
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource PageHeaderMargin}"
            HorizontalAlignment="Left"
            BadgeIcon="{x:Bind ViewModel.OneDriveIcon, Mode=OneTime}"
            Icon="{x:Bind ViewModel.HeaderIcon, Mode=OneTime}" />

        <controls:MemoriesEmptyGalleryView
            x:Name="MemoriesPageSignOutState"
            Grid.Row="1"
            IsTabStop="False"
            Visibility="{x:Bind ViewModel.ShowSignOutState, Mode=OneWay}" />

        <Grid
            x:Name="MemoriesPageSignInState"
            Grid.Row="1"
            Margin="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.ShowSignInState, Mode=OneWay}">
            <ScrollViewer
                Padding="{StaticResource PageContentMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                IsHorizontalRailEnabled="False"
                IsVerticalRailEnabled="True"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Grid x:Name="GridContainer" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="HighlightTitle"
                        x:Uid="RecommendationPageHighlightTitle"
                        Grid.Row="0"
                        Margin="{StaticResource RecommendationHighlightMarginStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="2"
                        FontSize="16"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <GridView
                        x:Name="RecommendationGridView"
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemClick="GridView_ItemClick"
                        ItemContainerStyle="{StaticResource RecommendationGridViewStyle}"
                        ItemTemplateSelector="{StaticResource RecommendationItemTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.RecommendationItems}"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None" />

                    <TextBlock
                        x:Name="OneDriveAlbumsTitle"
                        x:Uid="RecommendationPageOneDriveAlbumsTitle"
                        Grid.Row="2"
                        Margin="{StaticResource OneDriveAlbumHeaderMarginStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="2"
                        FontSize="16"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        Visibility="{x:Bind conv:VisibilityConverter.Convert(ViewModel.OneDriveGraphObservable.Albums.Count), Mode=OneWay}" />

                    <GridView
                        x:Name="AlbumsGridView"
                        Grid.Row="3"
                        IsItemClickEnabled="True"
                        ItemClick="GridView_ItemClick"
                        ItemContainerStyle="{StaticResource RecommendationGridViewStyle}"
                        ItemsSource="{x:Bind ViewModel.OneDriveGraphObservable.Albums, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="oneDrive:Album">
                                <Grid
                                    Width="{StaticResource RecommendationTileWidth}"
                                    Height="{StaticResource RecommendationTileHeight}"
                                    AutomationProperties.HelpText="{x:Bind vm:RecommendationViewModel.GetHelpText(ChildCount, CreatedDateTime)}"
                                    AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('MemoriesTile_Grid/AutomationProperties/LocalizedControlType'), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind Name}">
                                    <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border Background="{StaticResource RecommendationTileGradientBrush}" />
                                    <StackPanel
                                        Padding="{StaticResource RecommendationTileContentPadding}"
                                        VerticalAlignment="Bottom"
                                        Orientation="Vertical">
                                        <TextBlock
                                            Margin="{StaticResource RecommendationTileNameMargin}"
                                            VerticalAlignment="Bottom"
                                            FontSize="{StaticResource RecommendationTileNameFontSize}"
                                            Foreground="White"
                                            MaxLines="1"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            FontSize="{StaticResource RecommendationTileSubTextFontSize}"
                                            Foreground="White"
                                            Text="{x:Bind vm:RecommendationViewModel.GetSubText(ChildCount, CreatedDateTime)}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
