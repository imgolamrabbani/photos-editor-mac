<UserControl
    x:Class="Photos.Controls.Timeline.TimelineScrollbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tl="using:Photos.Controls.Timeline"
    x:Name="TimelineScrollbarControl"
    GotFocus="TimelineScrollbarControl_GotFocus"
    IsTabStop="true"
    KeyboardAcceleratorPlacementMode="Hidden"
    LostFocus="TimelineScrollbarControl_LostFocus"
    Opacity="0"
    PointerPressed="TimelineScrollbarControl_PointerPressed"
    PreviewKeyDown="TimelineScrollbarControl_PreviewKeyDown"
    UseSystemFocusVisuals="true"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary x:Name="TimelineScrollbarDictionary">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Photos.Controls.Timeline/TimelineScrollbarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Home"
            Invoked="KeyboardAccelerator_HomeKey_Invoked"
            Modifiers="None" />
        <KeyboardAccelerator
            Key="End"
            Invoked="KeyboardAccelerator_EndKey_Invoked"
            Modifiers="None" />
        <KeyboardAccelerator
            Key="PageUp"
            Invoked="KeyboardAccelerator_SuppressKey_Invoked"
            Modifiers="None" />
        <KeyboardAccelerator
            Key="PageDown"
            Invoked="KeyboardAccelerator_SuppressKey_Invoked"
            Modifiers="None" />
        <KeyboardAccelerator
            Key="Up"
            Invoked="KeyboardAccelerator_SuppressKey_Invoked"
            Modifiers="None" />
        <KeyboardAccelerator
            Key="Down"
            Invoked="KeyboardAccelerator_SuppressKey_Invoked"
            Modifiers="None" />
    </UserControl.KeyboardAccelerators>
    <UserControl.ContextFlyout>
        <MenuFlyout
            x:Name="TimelineContextMenuFlyout"
            Closed="TimelineContextMenuFlyout_Closed"
            Opened="TimelineContextMenuFlyout_Opened">
            <!--  x:Name (GoToTopMenuFlyoutItem) is reported in telemetry. Do not change.  -->
            <MenuFlyoutItem
                x:Name="GoToTopMenuFlyoutItem"
                x:Uid="GoToTopMenuFlyoutItem"
                Command="{x:Bind ContextMenuGoToTopCommand}">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource PhotosUWPFontFamily}" Glyph="{StaticResource GoToTopIconGlyph}" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <!--  x:Name (GoToBottomMenuFlyoutItem) is reported in telemetry. Do not change.  -->
            <MenuFlyoutItem
                x:Name="GoToBottomMenuFlyoutItem"
                x:Uid="GoToBottomMenuFlyoutItem"
                Command="{x:Bind ContextMenuGoToBottomCommand}">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource PhotosUWPFontFamily}" Glyph="{StaticResource GoToBottomIconGlyph}" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.ContextFlyout>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Bind tl:TimelineScrollbar.ArrowDedicatedHeight}" />
            <RowDefinition Height="{x:Bind tl:TimelineScrollbar.TopBottomCollectionTargetAreaHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{x:Bind tl:TimelineScrollbar.TopBottomCollectionTargetAreaHeight}" />
            <RowDefinition Height="{x:Bind tl:TimelineScrollbar.ArrowDedicatedHeight}" />
        </Grid.RowDefinitions>

        <Popup
            x:Name="SecondaryLabelPopup"
            IsOpen="{x:Bind IsHoveringOrDragging, Mode=OneWay}"
            VerticalOffset="14">
            <Grid
                x:Name="SecondaryLabelContentGrid"
                Height="28"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="SecondaryLabelTextBlock"
                    Margin="{x:Bind tl:TimelineScrollbar.SecondaryLabelTextBlockMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable"
                    FontSize="12"
                    FontWeight="SemiBold" />
            </Grid>
        </Popup>

        <RepeatButton
            x:Name="UpArrowButton"
            Padding="{StaticResource TimelineUpArrowPadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Right"
            Click="UpArrowButton_Click"
            Interval="50"
            IsTabStop="False"
            Template="{StaticResource UpArrowTemplate}" />

        <Grid
            x:Name="TopTargetArea"
            Grid.Row="1"
            Background="Transparent"
            Tapped="TopTargetArea_Tapped" />

        <!--  MinHeight="1" so that ActualHeight is never 0.  -->
        <Grid
            x:Name="TimelineArea"
            Grid.Row="2"
            MinHeight="1"
            Padding="{StaticResource TimelineAreaPadding}"
            HorizontalAlignment="Stretch"
            Background="Transparent">
            <Canvas
                x:Name="TimelineLabelCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>

        <Grid
            x:Name="MarkersGrid"
            Grid.Row="2"
            Padding="{StaticResource TimelineAreaPadding}"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch">

            <Border
                x:Name="HoveringScrollMarker"
                Width="{StaticResource MarkerWidth}"
                Height="{StaticResource MarkerHeight}"
                VerticalAlignment="Top"
                Background="{ThemeResource TimelineHoveringScrollMarkerBrush}"
                CornerRadius="2"
                IsHitTestVisible="False"
                Visibility="{x:Bind IsHoveringOrDragging, Mode=OneWay}" />

            <Border
                x:Name="AnchoredScrollMarker"
                Width="{StaticResource MarkerWidth}"
                Height="{StaticResource MarkerHeight}"
                VerticalAlignment="Top"
                Background="{ThemeResource TimelineAnchoredScrollMarkerBrush}"
                CornerRadius="{StaticResource MarkerCornerRadius}"
                IsHitTestVisible="False" />
        </Grid>

        <Grid
            x:Name="BottomTargetArea"
            Grid.Row="3"
            Background="Transparent"
            Tapped="BottomTargetArea_Tapped" />

        <RepeatButton
            x:Name="DownArrowButton"
            Grid.Row="4"
            Padding="{StaticResource TimelineDownArrowPadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Right"
            Click="DownArrowButton_Click"
            Interval="50"
            IsTabStop="False"
            Template="{StaticResource DownArrowTemplate}" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TimelineOpacityVisualStateGroup">
                <VisualState x:Name="ShowState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TimelineScrollbarControl" Storyboard.TargetProperty="Opacity">
                            <SplineDoubleKeyFrame
                                KeySpline="0,0,0,1"
                                KeyTime="{StaticResource FadeInAnimationDuration}"
                                Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="HideState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TimelineScrollbarControl" Storyboard.TargetProperty="Opacity">
                            <SplineDoubleKeyFrame
                                KeySpline="0,0,0,1"
                                KeyTime="{StaticResource FadeOutAnimationDuration}"
                                Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="MarkerStateGroup">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="HoveringScrollMarker.Background" Value="{ThemeResource TimelineAnchoredScrollMarkerBrush}" />
                        <Setter Target="AnchoredScrollMarker.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
