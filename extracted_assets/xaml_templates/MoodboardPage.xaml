<Page
    x:Class="PhotosManager.Views.Pages.MoodboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:PhotosManager.Views.Controls"
    xmlns:conv="using:PhotosManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:PhotosManager.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhotosManager.Models"
    xmlns:mood="using:PhotosManager.Views.Controls.MoodboardControls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///PhotosManager/Styles/MoodboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <controls:ScopedModal>
        <controls:ScopedModal.UnderlayContent>
            <Grid x:Name="MoodboardRootGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="InfoBar" Height="Auto" />
                    <RowDefinition x:Name="ContentGrid" Height="*" />
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    x:Name="Moodboard_Warning_InfoBar"
                    Title="{x:Bind ViewModel.WarningInfoBarTitle, Mode=OneWay}"
                    Grid.Row="0"
                    VerticalAlignment="Stretch"
                    IsOpen="{x:Bind ViewModel.ShowWarningInfoBar, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.WarningInfoBarContent, Mode=OneWay}"
                    Severity="Warning" />
                <Grid
                    x:Name="MoodboardContentGrid"
                    Grid.Row="1"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="Header" Height="Auto" />
                        <RowDefinition x:Name="UserInputSection" Height="Auto" />
                        <RowDefinition x:Name="Debug" Height="Auto" />
                        <RowDefinition x:Name="GallerySection" Height="*" />
                    </Grid.RowDefinitions>

                    <mood:MoodboardPageHeader
                        Grid.Row="0"
                        Margin="{StaticResource PageHeaderMargin}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

                    <StackPanel
                        x:Name="Moodboard_UserInputSectionRoot"
                        Grid.Row="1"
                        Margin="{StaticResource MoodboardUserInputRootSectionMargin}"
                        HorizontalAlignment="Stretch"
                        Orientation="Vertical"
                        Spacing="16">
                        <Grid
                            x:Name="Moodboard_TextInputRow"
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" MaxWidth="200" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="Moodboard_PromptTextBox"
                                x:Uid="Moodboard_PromptTextBox"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Loaded="PromptTextBox_Loaded"
                                PreviewKeyUp="Moodboard_PromptTextBox_PreviewKeyUp"
                                Style="{StaticResource MoodboardGenerateTextboxStyle}"
                                TextChanged="Moodboard_PromptTextBox_TextChanged" />
                            <Button
                                x:Name="Moodboard_GenerateButton"
                                x:Uid="Moodboard_GenerateButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                AutomationProperties.LabeledBy="{Binding ElementName=MoodboardGenerateButtonText}"
                                Command="{x:Bind ViewModel.GenerateCommand, Mode=OneWay}"
                                CommandParameter="{Binding Text, ElementName=Moodboard_PromptTextBox, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsGenerateButtonEnabled, Mode=OneWay}"
                                Style="{StaticResource MoodboardGenerateButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource PhotosUWPFontFamily}" Glyph="&#xE344;" />
                                    <TextBlock x:Name="MoodboardGenerateButtonText" x:Uid="Moodboard_GenerateButtonText" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid
                            x:Name="Moodboard_PromptSuggestionRow"
                            Margin="1,0,0,0"
                            Visibility="{x:Bind conv:VisibilityConverter.Invert(ViewModel.ShowLandingPage), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CreativityInfoButtonArea" Width="27" />
                                <ColumnDefinition x:Name="CreativitySliderStackPanelArea" Width="auto" />
                                <ColumnDefinition x:Name="SeparatorArea" Width="auto" />
                                <ColumnDefinition x:Name="PromptSuggestionArea" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="Moodboard_CreativityInfoButton"
                                x:Uid="Moodboard_CreativityInfoButton"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="0,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="&#xF5F0;"
                                FontFamily="{StaticResource PhotosUWPFontFamily}"
                                FontSize="16">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <!--  StackPanel is needed for screen reader to work properly when opening the Flyout  -->
                                        <StackPanel
                                            MaxWidth="300"
                                            Background="Transparent"
                                            Orientation="Vertical">
                                            <TextBlock x:Uid="Moodboard_Creativity_Info_Content" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <StackPanel
                                x:Name="Moodboard_CreativitySliderStackPanel"
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    x:Name="Moodboard_CreativitySliderText"
                                    x:Uid="Moodboard_CreativityText"
                                    VerticalAlignment="Center" />
                                <Slider
                                    Width="200"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LabeledBy="{Binding ElementName=Moodboard_CreativitySliderText}"
                                    Maximum="100"
                                    Minimum="0"
                                    SmallChange="1"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.MoodboardObservable.Creativity, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.MoodboardObservable.Creativity, Mode=OneWay}" />
                            </StackPanel>

                            <AppBarSeparator Grid.Column="2" />
                            <controls:MoodboardPromptSuggestionsControl x:Name="Moodboard_PromptSuggestionsControl" Grid.Column="3" />
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        x:Name="DebugMoodboardUI"
                        Grid.Row="2"
                        Margin="20,10,0,0"
                        Orientation="Horizontal"
                        Spacing="5"
                        Visibility="{x:Bind ViewModel.IsDebugUIEnabled, Mode=OneWay}">
                        <TextBlock x:Name="DebugMoodboardUI_HiddenPromptText" VerticalAlignment="Center">[DEBUG] Hidden prompt:</TextBlock>
                        <CheckBox
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.LabeledBy="{Binding ElementName=DebugMoodboardUI_HiddenPromptText}"
                            IsChecked="{x:Bind ViewModel.MoodboardObservable.UseHiddenPrompt, Mode=TwoWay}" />

                        <TextBlock
                            x:Name="DebugMoodboardUI_SketchToImageCreativity"
                            Margin="-80,0,0,0"
                            VerticalAlignment="Center">
                            [DEBUG] SketchToImageCreativity:
                        </TextBlock>
                        <Slider
                            Width="100"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.LabeledBy="{Binding ElementName=DebugMoodboardUI_SketchToImageCreativity}"
                            Maximum="95"
                            Minimum="10"
                            SmallChange="1"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.MoodboardObservable.SketchToImageCreativity, Mode=TwoWay}" />
                        <TextBlock
                            x:Name="DebugMoodboardUI_InferenceStepsText"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">
                            [DEBUG] Inference steps:
                        </TextBlock>
                        <Slider
                            Width="100"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.LabeledBy="{Binding ElementName=DebugMoodboardUI_InferenceStepsText}"
                            Maximum="30"
                            Minimum="2"
                            SmallChange="1"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.MoodboardObservable.InferenceSteps, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid x:Name="Moodboard_GallerySectionRoot" Grid.Row="3">
                        <!--
                            Gallery for the sample images, which are present when user first lands the Moodboard page but goes away when user starts generating results
                        -->
                        <controls:MoodboardSamplesGalleryView
                            x:Name="Moodboard_LandingGallery"
                            SampleSelected="MoodboardLandingPage_SampleSelected"
                            Visibility="{x:Bind ViewModel.ShowLandingPage, Mode=OneWay}" />

                        <!--
                            Gallery for the result images - we use the MoodboardResultsGalleryView as the DataTemplate in a ListView to stack each group of results together
                            Todo: implement the mroe specific behaviors of the results UI - https://dev.azure.com/microsoft/OS/_workitems/edit/49701241
                        -->
                        <ListView
                            x:Name="Moodboard_ResultsGallery"
                            Margin="0,16,0,0"
                            ItemsSource="{x:Bind ViewModel.MoodboardObservable.GeneratedResults, Mode=OneWay}"
                            Loaded="ResultsGallery_Loaded"
                            SelectionMode="None"
                            Visibility="{x:Bind conv:VisibilityConverter.Invert(ViewModel.ShowLandingPage), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MoodboardResult">
                                    <controls:MoodboardResultsGalleryView
                                        AutomationProperties.Name="{x:Bind DisplayText, Mode=OneTime}"
                                        DisplayText="{x:Bind DisplayText}"
                                        MoodboardResult="{x:Bind}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>

                        <Grid
                            x:Name="Moodboard_BottomButtonRoot"
                            Height="72"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource MoodboardPageBottomGradientBrush}"
                            Visibility="{x:Bind conv:VisibilityConverter.Either(ViewModel.IsStopGeneratingButtonVisible, ViewModel.IsScrollToGenerateButtonVisible), Mode=OneWay}">
                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation
                                    From="0"
                                    To="1"
                                    Duration="0:0:0.1" />
                            </animations:Implicit.ShowAnimations>
                            <animations:Implicit.HideAnimations>
                                <animations:OpacityAnimation
                                    From="1"
                                    To="0"
                                    Duration="0:0:0.1" />
                            </animations:Implicit.HideAnimations>

                            <Grid
                                x:Name="Moodboard_BottomButtonContainer"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                                <Border
                                    x:Name="Moodboard_BottomButtonBorder"
                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                    BorderBrush="{StaticResource MoodboardResultsTitleAccentGradientBrush}"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource MoodboardTileButtonCornerRadius}" />
                                <Button
                                    x:Name="Moodboard_BottomButton"
                                    AutomationProperties.LabeledBy="{Binding ElementName=MoodboardBottomButtonText}"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.StopOrScrollCommand, Mode=OneWay}"
                                    CornerRadius="{StaticResource MoodboardTileButtonCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource PhotosUWPFontFamily}" Glyph="{x:Bind ViewModel.BottomButtonGlyph(ViewModel.IsStopGeneratingButtonVisible, ViewModel.IsScrollToGenerateButtonVisible), Mode=OneWay}" />
                                        <TextBlock
                                            x:Name="MoodboardBottomButtonText"
                                            VerticalAlignment="Top"
                                            Text="{x:Bind ViewModel.BottomButtonLabel(ViewModel.IsStopGeneratingButtonVisible, ViewModel.IsScrollToGenerateButtonVisible), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </controls:ScopedModal.UnderlayContent>
    </controls:ScopedModal>
</Page>
