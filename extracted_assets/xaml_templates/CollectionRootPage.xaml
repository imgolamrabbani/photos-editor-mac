<Page
    x:Class="PhotosManager.Views.Pages.CollectionRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:PhotosManager.Views.Controls"
    xmlns:conv="using:PhotosManager.Converters"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataTemplates="using:PhotosManager.DataTemplates"
    xmlns:ex="using:PhotosManager.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhotosManager.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:pages="using:PhotosManager.Views.Pages"
    xmlns:pc="using:Photos.Controls"
    xmlns:sltor="using:PhotosManager.Selectors"
    xmlns:viewer="using:Lightbox"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <dataTemplates:MenuItemsTemplate />
                <ResourceDictionary Source="ms-appx:///PhotosManager/Styles/SizerStyles.xaml" />
                <ResourceDictionary>
                    <sltor:MenuItemTemplateSelector
                        x:Key="MenuItemTemplateSelector"
                        DefaultTemplate="{StaticResource DefaultTemplate}"
                        FolderGalleryTemplate="{StaticResource FolderGalleryTemplate}"
                        FoldersListTemplate="{StaticResource FoldersListTemplate}"
                        HeaderTemplate="{StaticResource HeaderTemplate}"
                        ImportTemplate="{StaticResource ImportTemplate}"
                        LocalOnlyTemplate="{StaticResource LocalOnlyTemplate}"
                        MainGalleryTemplate="{StaticResource MainGalleryTemplate}"
                        SeparatorTemplate="{StaticResource SeparatorTemplate}" />

                    <sltor:CollectionRootTitleBarTemplateSelector
                        x:Key="RootTitleBarTemplateSelector"
                        CollectionTitleBarTemplate="{StaticResource CollectionTitleBarTemplate}"
                        EditTitleBarTemplate="{StaticResource EditTitleBarTemplate}"
                        EmptyTitleBarTemplate="{StaticResource EmptyTitleBarTemplate}"
                        ViewerTitleBarTemplate="{StaticResource ViewerTitleBarTemplate}" />

                    <DataTemplate x:Key="CollectionTitleBarTemplate">
                        <controls:CollectionTitleBar />
                    </DataTemplate>

                    <DataTemplate x:Key="ViewerTitleBarTemplate">
                        <controls:CollectionInlineViewerTitleBar AppIconAndNameWidth="{Binding ElementName=RootPage, Path=ViewModel.NavigationPaneWidth, Mode=OneWay}" />
                    </DataTemplate>

                    <DataTemplate x:Key="EditTitleBarTemplate">
                        <viewer:EditTitleBar />
                    </DataTemplate>

                    <DataTemplate x:Key="EmptyTitleBarTemplate">
                        <Grid />
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragOver="RootGrid_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <muxc:NavigationView
                x:Name="NavigationViewControl"
                Background="Transparent"
                Collapsed="NavigationViewControl_Collapsed"
                CompactModeThresholdWidth="0"
                FooterMenuItemsSource="{x:Bind MenuItemsViewModel.FooterMenuItems, Mode=OneWay}"
                IsBackButtonVisible="Collapsed"
                IsPaneVisible="{x:Bind ViewModel.IsNavigationPaneVisible(NavigationViewModel.CurrentPageInfo), Mode=OneWay}"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                Loaded="NavigationViewControl_Loaded"
                MenuItemTemplateSelector="{StaticResource MenuItemTemplateSelector}"
                MenuItemsSource="{x:Bind MenuItemsViewModel.AllMenuItems, Mode=OneWay}"
                PaneClosed="NavigationViewControl_PaneClosed"
                PaneClosing="NavigationViewControl_PaneClosing"
                PaneOpened="NavigationViewControl_PaneOpened"
                PaneOpening="NavigationViewControl_PaneOpening"
                PointerPressed="NavigationViewControl_PointerPressed"
                PreviewKeyDown="NavigationViewControl_PreviewKeyDown"
                SelectedItem="{x:Bind MenuItemsViewModel.SelectedMenuItem, Mode=OneWay}"
                SelectionChanged="NavigationViewControl_SelectionChanged"
                TabIndex="0"
                Tapped="NavigationViewControl_Tapped">

                <RelativePanel
                    x:Name="NavigationViewMainPanel"
                    MinWidth="{x:Bind pages:CollectionRootPage.MinMainPanelWidth}"
                    AutomationProperties.LocalizedLandmarkType="{x:Bind ex:StringExtensions.Localized('MainPanel/AutomationProperties/LocalizedLandmarkType'), Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind ex:StringExtensions.Localized('MainPanel/AutomationProperties/Name'), Mode=OneTime}">

                    <ctc:PropertySizer
                        x:Name="Gripper"
                        AutomationProperties.HelpText="{x:Bind ex:StringExtensions.Localized('CollectionRootPage_Gripper/AutomationProperties/HelpText'), Mode=OneTime}"
                        AutomationProperties.LocalizedControlType="{x:Bind ex:StringExtensions.Localized('CollectionRootPage_Gripper/AutomationProperties/LocalizedControlType'), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind ex:StringExtensions.Localized('CollectionRootPage_Gripper/AutomationProperties/Name'), Mode=OneTime}"
                        Background="Transparent"
                        Binding="{Binding OpenPaneLength, ElementName=NavigationViewControl, Mode=TwoWay}"
                        ManipulationCompleted="Gripper_ManipulationCompleted"
                        ManipulationStarting="Gripper_ManipulationStarting"
                        Maximum="{x:Bind ViewModel.MaxNavigationViewWidth, Mode=OneWay}"
                        Minimum="52"
                        PreviewKeyUp="Gripper_PreviewKeyUp"
                        RelativePanel.AlignBottomWithPanel="True"
                        RelativePanel.AlignLeftWithPanel="True"
                        RelativePanel.AlignTopWithPanel="True"
                        Style="{StaticResource LeftNavGripperStyle}"
                        Visibility="{Binding IsPaneOpen, ElementName=NavigationViewControl}" />

                    <Frame
                        x:Name="NavigationFrame"
                        MinWidth="{x:Bind pages:CollectionRootPage.MinContentWidth}"
                        Margin="{x:Bind ViewModel.GetFrameMargin(Gripper.Visibility, NavigationViewModel.CurrentPageInfo), Mode=OneWay}"
                        VerticalAlignment="Stretch"
                        RelativePanel.AlignBottomWithPanel="True"
                        RelativePanel.AlignRightWithPanel="True"
                        RelativePanel.Below="BannerContainer"
                        RelativePanel.RightOf="Gripper" />

                    <!--
                        TODO: Refactor this grid into a component dedicated to displaying the banners.
                        https://microsoft.visualstudio.com/OS/_workitems/edit/47367442
                    -->
                    <Grid
                        x:Name="BannerContainer"
                        Margin="0,0,0,-29"
                        RelativePanel.AlignLeftWithPanel="True"
                        RelativePanel.AlignRightWithPanel="True"
                        RelativePanel.AlignTopWithPanel="True"
                        RelativePanel.RightOf="Gripper">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <controls:PhotosPreviewBanner
                            x:Name="PhotosPreviewBanner"
                            Grid.Row="0"
                            Margin="0,0,0,29"
                            x:Load="false" />
                        <controls:OneDriveQuotaUpsellControl x:Name="OneDriveQuotaUpsellBanner" Grid.Row="1" />
                        <controls:GraphSignInControl
                            x:Name="GraphSignInBanner"
                            Grid.Row="2"
                            Margin="0,0,0,29"
                            x:Load="false" />
                    </Grid>

                    <controls:ToastNotificationControl
                        x:Name="ToastNotification"
                        RelativePanel.AlignBottomWithPanel="True"
                        RelativePanel.AlignLeftWithPanel="True"
                        RelativePanel.AlignRightWithPanel="True" />
                </RelativePanel>

                <muxc:NavigationView.PaneFooter>
                    <controls:OneDriveQuotaView Margin="0,0,0,-8" IsNavigationPaneOpen="{Binding IsPaneOpen, ElementName=NavigationViewControl}" />
                </muxc:NavigationView.PaneFooter>

            </muxc:NavigationView>

            <controls:ScreenReaderAnnouncementControl x:Name="ScreenReaderAnnouncementControl" />
        </Grid>

        <!--  RootTitleBar is declared below the content because it needs to be on top of it in full screen.  -->
        <pc:RootTitleBar
            x:Name="RootTitleBarControl"
            Grid.Row="0"
            VerticalAlignment="Top"
            IsFullScreenSystemButtonsVisible="{x:Bind FullScreenViewModel.IsFullScreen, Mode=OneWay}"
            TabIndex="1"
            TitleBarTemplateSelector="{StaticResource RootTitleBarTemplateSelector}"
            TitleBarType="{x:Bind ViewModel.GetTitleBarType(NavigationViewModel.CurrentPageInfo), Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsTitleBarVisible(ViewModel.IsPointerAtTheTop, FullScreenViewModel.IsFullScreen), Mode=OneWay}">
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation
                    From="0"
                    To="1"
                    Duration="0:0:0.3" />
            </animations:Implicit.ShowAnimations>

            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation
                    From="1"
                    To="0"
                    Duration="0:0:0.15" />
            </animations:Implicit.HideAnimations>
        </pc:RootTitleBar>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="FullScreen">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind FullScreenViewModel.IsFullScreen, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootTitleBarControl.Background" Value="{ThemeResource TitleBarFullScreenBackground}" />
                        <Setter Target="RootTitleBarControl.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
