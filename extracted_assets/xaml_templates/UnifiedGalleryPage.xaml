<Page
    x:Class="PhotosManager.Views.Pages.UnifiedGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotosManager.Views.Controls"
    xmlns:conv="using:PhotosManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:PhotosManager.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhotosManager.Models"
    xmlns:ui="using:CommunityToolkit.WinUI"
    AllowDrop="True"
    DragOver="UnifiedGalleryPage_DragOver"
    Drop="UnifiedGalleryPage_Drop"
    NavigationCacheMode="Required"
    Style="{StaticResource ScrollingPageStyle}"
    mc:Ignorable="d">

    <Grid
        x:Name="ContentArea"
        PointerPressed="ContentArea_PointerPressed"
        Visibility="{x:Bind conv:VisibilityConverter.Convert(ViewModel.IsContentVisible), Mode=OneWay}">
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout Closed="MenuFlyout_Closed" Opened="MenuFlyout_Opened">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Clicked"
                    Command="{x:Bind PasteViewModel.PasteStorageFilesCommand, Mode=OneTime}"
                    CommandParameter="{x:Bind ViewModel.ActiveFolderTracker.ActiveFolderId, Mode=OneWay}"
                    Icon="{ui:FontIcon Glyph=&#xE77F;}"
                    Text="{x:Bind ex:StringExtensions.Localized('MenuFlyoutItem_PasteCommand'), Mode=OneTime}" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:GalleryHeader Grid.Row="0" VerticalAlignment="Stretch" />

        <controls:GalleryView
            x:Name="UnifiedGalleryView"
            Grid.Row="1"
            Items="{x:Bind ViewModel.UIState.DisplayableMediaItems, Mode=OneWay}"
            TimelineGranularity="{x:Bind ViewModel.TimelineGranularity, Mode=OneWay}"
            Visibility="{x:Bind conv:VisibilityConverter.Match(GalleryVisibilityViewModel.GalleryVisibility, models:GalleryVisibility.GalleryVisible), Mode=OneWay}"
            VisibleRangeChanged="UnifiedGalleryView_VisibleRangeChanged" />

        <controls:LoadingGalleryView
            x:Name="LoadingGalleryView"
            Grid.Row="1"
            x:Load="{x:Bind conv:BoolConverter.Match(GalleryVisibilityViewModel.GalleryVisibility, models:GalleryVisibility.LoadingGalleryVisible), Mode=OneWay}"
            GalleryType="{x:Bind ViewModel.CurrentGalleryType, Mode=OneWay}" />

        <controls:EmptyGalleryView
            x:Name="UnifiedEmptyGalleryView"
            Grid.Row="1"
            x:Load="{x:Bind conv:BoolConverter.Match(GalleryVisibilityViewModel.GalleryVisibility, models:GalleryVisibility.EmptyGalleryVisible), Mode=OneWay}"
            GalleryType="{x:Bind ViewModel.CurrentGalleryType, Mode=OneWay}"
            IsTabStop="False" />
    </Grid>
</Page>
