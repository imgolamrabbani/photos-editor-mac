<Page
    x:Class="PhotosManager.Views.Pages.ImportGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhotosManager.Views.Controls"
    xmlns:conv="using:PhotosManager.Converters"
    xmlns:core="using:PhotosCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:PhotosManager.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Photos.Models"
    Loaded="Page_Loaded"
    Style="{StaticResource ScrollingPageStyle}"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <x:String x:Key="AlreadyImportedGlyph">&#xE73E;</x:String>
            <x:String x:Key="NewImportGlyph">&#xECF4;</x:String>
            <x:String x:Key="VideoGlyph">&#xF411;</x:String>
            <Thickness x:Key="ImportSelectMargin">0,0,10,0</Thickness>
            <x:Double x:Key="ImportTileSizeWidth">287</x:Double>
            <x:Double x:Key="ImportTileSizeHeight">227</x:Double>
            <x:Double x:Key="ImportTileImageHeight">192</x:Double>
            <x:Double x:Key="ImportTileTextFontSize">12</x:Double>
            <Thickness x:Key="ImportTileMargin">0,7,14,7</Thickness>
            <Thickness x:Key="AlreadyImportedIconMargin">5,0,-8,0</Thickness>
            <Thickness x:Key="ImportNewIconMargin">5,-15,-5,0</Thickness>
            <Thickness x:Key="ImportTileNameMargin">10,15,10,0</Thickness>
            <Thickness x:Key="ImportTileFileSizeMargin">0,15,10,12</Thickness>
            <Thickness x:Key="ImportTileRawMargin">10,5</Thickness>
            <x:Double x:Key="ListViewItemDisabledThemeOpacity">0.1</x:Double>
        </ResourceDictionary>
    </Page.Resources>

    <Grid
        x:Name="ContentArea"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ImportPageHeader
            Grid.Row="0"
            Margin="{StaticResource PageHeaderMargin}"
            VerticalAlignment="Stretch" />

        <controls:EmptyGalleryView
            x:Name="OneDriveEmptyGallery"
            Grid.Row="1"
            x:Load="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
            GalleryType="{x:Bind models:GalleryType.Import, Mode=OneTime}"
            IsTabStop="False" />

        <Grid
            x:Name="ImportGallery"
            Grid.Row="1"
            Visibility="{x:Bind conv:VisibilityConverter.Invert(ViewModel.ShowEmptyState), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TopBarGrid"
                Grid.Row="0"
                Padding="{StaticResource PageContentMargin}"
                HorizontalAlignment="Stretch"
                Loaded="TopBarGrid_Loaded"
                SizeChanged="TopBarGrid_SizeChanged"
                Visibility="{x:Bind conv:VisibilityConverter.Convert(ViewModel.ShowTopBarGrid), Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="SelectNewCheckBox"
                            Grid.Column="0"
                            MinWidth="0"
                            MaxWidth="{x:Bind ViewModel.TopBarCheckboxMaxWidth, Mode=OneWay}"
                            Margin="{StaticResource ImportSelectMargin}"
                            HorizontalAlignment="Left"
                            AutomationProperties.LabeledBy="{Binding ElementName=SelectNewDisplayText}"
                            Checked="SelectNewCheckBox_Checked"
                            IsEnabled="{x:Bind ViewModel.SelectNewEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectNewDisplayText, Mode=OneWay}"
                            Unchecked="SelectNewCheckBox_Unchecked">
                            <TextBlock
                                x:Name="SelectNewDisplayText"
                                Text="{x:Bind ViewModel.SelectNewDisplayText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                        <CheckBox
                            x:Name="SelectAllCheckBox"
                            Grid.Column="1"
                            MinWidth="0"
                            MaxWidth="{x:Bind ViewModel.TopBarCheckboxMaxWidth, Mode=OneWay}"
                            Margin="{StaticResource ImportSelectMargin}"
                            HorizontalAlignment="Left"
                            AutomationProperties.LabeledBy="{Binding ElementName=SelectAllDisplayText}"
                            Checked="SelectAllCheckBox_Checked"
                            IsEnabled="{x:Bind ViewModel.SelectAllEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SelectAllDisplayText, Mode=OneWay}"
                            Unchecked="SelectAllCheckBox_Unchecked">
                            <TextBlock
                                x:Name="SelectAllDisplayText"
                                Text="{x:Bind ViewModel.SelectAllDisplayText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                    </Grid>
                    <ToggleSwitch
                        x:Name="SelectedOnlyToggleButton"
                        MinWidth="0"
                        MaxWidth="{x:Bind ViewModel.TopBarToggleSwitchMaxWidth, Mode=OneWay}"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Right"
                        AutomationProperties.Name="{x:Bind GetSelectedOnlyToggleButtonFriendlyName(ViewModel.ShouldOnlyShowSelected), Mode=OneWay}"
                        BorderThickness="0"
                        CornerRadius="16"
                        IsEnabled="{x:Bind conv:BoolConverter.Invert(ViewModel.IsSelectAllChecked), Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.ShouldOnlyShowSelected, Mode=OneWay}"
                        Toggled="SelectedOnlyToggleButton_Toggled"
                        ToolTipService.ToolTip="{x:Bind GetSelectedOnlyToggleButtonFriendlyName(ViewModel.ShouldOnlyShowSelected), Mode=OneWay}">
                        <ToggleSwitch.OnContent>
                            <TextBlock
                                x:Name="ShowOnlySelectedButtonOnText"
                                MaxWidth="{x:Bind ViewModel.TopBarToggleSwitchTextMaxWidth, Mode=OneWay}"
                                Text="{x:Bind ex:StringExtensions.Localized('ShowOnlySelectedButton/OnContent'), Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                        </ToggleSwitch.OnContent>
                        <ToggleSwitch.OffContent>
                            <TextBlock
                                x:Name="ShowOnlySelectedButtonOffText"
                                MaxWidth="{x:Bind ViewModel.TopBarToggleSwitchTextMaxWidth, Mode=OneWay}"
                                Text="{x:Bind ex:StringExtensions.Localized('ShowOnlySelectedButton/OffContent'), Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                        </ToggleSwitch.OffContent>
                    </ToggleSwitch>
                </Grid>
            </Grid>
            <GridView
                x:Name="ImportItemGridView"
                Grid.Row="1"
                Padding="{StaticResource PageContentMargin}"
                DragItemsStarting="ImportItemGridView_DragItemsStarting"
                IsEnabled="{x:Bind conv:BoolConverter.Invert(ViewModel.IsImporting), Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.GetDisplayedItems(ViewModel.ShouldOnlyShowSelected, ViewModel.UIState.SelectedImportFolder), Mode=OneWay}"
                Loaded="ImportItemGridView_Loaded"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollMode="Enabled"
                SelectionChanged="ImportItemGridView_SelectionChanged"
                SelectionMode="{x:Bind ViewModel.GridViewSelectionMode, Mode=OneWay}"
                Unloaded="ImportItemGridView_Unloaded">
                <GridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="{StaticResource ImportTileMargin}" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="core:ImportMediaItem">
                        <Grid
                            Width="{StaticResource ImportTileSizeWidth}"
                            Height="{StaticResource ImportTileSizeHeight}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Loaded="ImportMediaItem_Loaded"
                            Opacity="{x:Bind conv:DoubleConverter.Convert(Imported, 1, 0.4)}"
                            Tag="{x:Bind KeyAsString}"
                            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="8*" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>
                            <Image
                                Grid.Row="0"
                                Width="{StaticResource ImportTileSizeWidth}"
                                Height="{StaticResource ImportTileImageHeight}"
                                Source="{x:Bind ThumbnailImage, Mode=OneWay}"
                                Stretch="Uniform" />
                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="ImportStatusIcon"
                                    Grid.Column="0"
                                    Margin="{StaticResource ImportNewIconMargin}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource PhotosUWPFontFamily}"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    Glyph="{StaticResource NewImportGlyph}"
                                    Visibility="{x:Bind conv:VisibilityConverter.Invert(Imported), Mode=OneWay}" />
                                <FontIcon
                                    Grid.Column="0"
                                    Margin="{StaticResource AlreadyImportedIconMargin}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource PhotosUWPFontFamily}"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="{StaticResource AlreadyImportedGlyph}"
                                    Visibility="{x:Bind Imported, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="{StaticResource ImportTileNameMargin}"
                                    HorizontalAlignment="Left"
                                    FontSize="{StaticResource ImportTileTextFontSize}"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="{StaticResource ImportTileFileSizeMargin}"
                                    HorizontalAlignment="Right"
                                    FontSize="{StaticResource ImportTileTextFontSize}"
                                    Text="{x:Bind conv:StringConverter.FormatSize(FileSizeInBytes), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                            <Grid
                                Margin="{StaticResource ImportTileRawMargin}"
                                Padding="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SolidBackgroundFillColorSecondary}"
                                CornerRadius="4"
                                Visibility="{x:Bind conv:StringConverter.EndsWith(Name, '.RAW'), Mode=OneWay}">
                                <TextBlock Text="RAW" />
                            </Grid>
                            <FontIcon
                                Margin="10,5,5,10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource PhotosUWPFontFamily}"
                                FontSize="24"
                                Glyph="{StaticResource VideoGlyph}"
                                Visibility="{x:Bind conv:VisibilityConverter.Invert(IsImage), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="{x:Bind conv:VisibilityConverter.Convert(ViewModel.IsImporting), Mode=OneWay}">
            <ProgressRing
                Width="60"
                Height="60"
                Padding="0,0,0,14"
                IsActive="True" />
            <TextBlock
                x:Uid="ImportGallery_IsImporting_Title"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold" />
            <TextBlock
                x:Uid="ImportGallery_IsImporting_Message"
                HorizontalAlignment="Center"
                FontSize="14" />
        </StackPanel>
        <!--  Anchor control for drag&drop custom UI. This control gets rendered to a bitmap to be set in the drad&drop UI override. It is not part of the app, as only the bitmap is used in the UI. It needs to be in the XAML tree, loaded & visible so it can be rendered.  -->
        <controls:GalleryDragUI x:Name="ImportDragUI" x:Load="False">
            <!--  It needs to be loaded so it can be rendered. This makes it visible in the app window, which causes it to flicker once we unload it, before the drag&drop UI gets set.  -->
            <!--  To prevent the flickering, and only show it when the drag&drop UI is ready, translate it out of the app window. It will still be loaded in the tree and not collapsed, so it can be rendered to a bitmap.  -->
            <controls:GalleryDragUI.RenderTransform>
                <TranslateTransform x:Name="ImportDragUITransform" X="10000" Y="10000" />
            </controls:GalleryDragUI.RenderTransform>
        </controls:GalleryDragUI>
    </Grid>
</Page>
